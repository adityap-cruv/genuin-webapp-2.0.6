{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.json", ".env.*local"],
  "globalEnv": ["NODE_ENV", "NEXT_PUBLIC_*", "INTERNAL_API_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "outputs": [".next/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "start": {
      "dependsOn": ["build"],
      "outputs": [".next/**"]
    }
  }
}

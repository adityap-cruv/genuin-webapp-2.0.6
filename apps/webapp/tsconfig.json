{
  "extends": "@genuin/typescript-config/nextjs.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": ["react", "react-dom", "node"],
    "baseUrl": ".",
    "paths": {
      "auth": ["./auth"],
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@lib/*": ["./src/lib/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@icons/*": ["./public/icons/*"],
      "@images/*": ["./public/images/*"],
      "@services/*": ["./src/services/*"],
      "@lotties/*": ["./public/lotties/*"],
      "@genuin/ui": ["../../packages/ui/src/index.ts"],
      "@genuin/ui/*": ["../../packages/ui/src/*"],
      "@genuin/components": ["../../packages/components/src/index.ts"],
      "@genuin/components/*": ["../../packages/components/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    "types/next-auth.d.ts",
    ".next/types/**/*.ts",
    "../../packages/components/src/types/genuin-sdk.d.ts"
  ],
  "exclude": ["node_modules", "postcss.config.js", ".next"]
}

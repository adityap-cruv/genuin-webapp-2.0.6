{
  "name": "@genuin/webapp",
  "version": "2.14.5",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "env-cmd -f ../../.env next dev -p 4005",
    "dev:turbo": "env-cmd -f ../../.env NEXT_TURBO=true next dev --turbo -p 4005",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "lint:fix": "lint . --fix",
    "br": "env-cmd -f ../../.env.production.local next build && cp -r .next/static .next/standalone/apps/webapp/.next/ && cp -r public .next/standalone/apps/webapp/public/ && env-cmd -f ../../.env.production.local node .next/standalone/apps/webapp/server.js",
    "check-node": "node ../../scripts/check-node-version.js",
    "predev": "ALLOW_NODE_VERSION_WARNING=true npm run check-node",
    "predev:turbo": "ALLOW_NODE_VERSION_WARNING=true npm run check-node"
  },
  "husky": {
    "hooks": {
      "pre-push": "npm run build"
    }
  },
  "dependencies": {
    "@auth/core": "^0.28.0",
    "@fingerprintjs/fingerprintjs": "^4.2.2",
    "@genuin/components": "workspace:*",
    "@genuin/ui": "workspace:*",
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/number": "^1.1.0",
    "@radix-ui/react-aspect-ratio": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.3.6",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.13",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@rudderstack/analytics-js": "^3.11.16",
    "@sentry/nextjs": "^8.38.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tanstack/react-query": "^5.76.1",
    "@tanstack/react-query-devtools": "^5.76.0",
    "axios": "^1.9.0",
    "classnames": "^2.5.1",
    "cmdk": "^1.1.1",
    "cropperjs": "^2.0.0",
    "dompurify": "^3.2.5",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.12.5",
    "immer": "^10.1.1",
    "input-otp": "^1.4.2",
    "mobile-detect": "^1.4.5",
    "motion": "^12.18.1",
    "next": "15.2.0",
    "next-auth": "^5.0.0-beta.28",
    "openplayerjs": "^2.14.10",
    "react-cropper": "^2.3.3",
    "react-flag-kit": "^1.1.1",
    "react-hook-form": "^7.56.4",
    "react-phone-number-input": "^3.4.12",
    "react-qrcode-logo": "^3.0.0",
    "sass": "^1.70.0",
    "swiper": "^11.2.7",
    "ua-parser-js": "^2.0.3",
    "use-debounce": "^10.0.4",
    "uuid": "^11.0.5",
    "zod": "^3.25.16",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@genuin/typescript-config": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/grecaptcha": "^3.0.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^9.0.8",
    "autoprefixer": "10.4.21",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "critters": "^0.0.24",
    "postcss": "^8.5.3",
    "prettier": "^3.2.4",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.8",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.3",
    "url-loader": "^4.1.1"
  }
}

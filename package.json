{
  "name": "@genuin/webapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.3",
  "engines": {
    "node": ">=18.17.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "prettier": "^3.2.4",
    "turbo": "^1.12.5"
  }
}

{
  "name": "@genuin/webapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "components": "npx concurrently \"pnpm --filter @genuin/ui storybook\" \"pnpm --filter @genuin/components storybook\" \"pnpm  --filter @genuin/ui dev:styles\"",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install",
    "check-node": "node ./scripts/check-node-version.js",
    "preinstall": "npm run check-node",
    "predev": "ALLOW_NODE_VERSION_WARNING=true npm run check-node",
    "prebuild": "npm run check-node",
    "use-correct-node": "nvm install && nvm use",
    "upgrade-node": "nvm install 20.12.0 && nvm alias default 20.12.0 && nvm use 20.12.0",
    "deps:check": "syncpack list-mismatches",
    "deps:fix": "syncpack fix-mismatches",
    "deps:update": "ncu -u && pnpm install",
    "deps:unused": "depcheck",
    "deps:validate": "pnpm deps:check && pnpm deps:unused"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.511.0",
    "mitt": "^3.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "tailwindcss": "^4.1.8",
    "zod": "^3.25.16"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@genuin/eslint-config": "workspace:*",
    "@genuin/typescript-config": "workspace:*",
    "@next/eslint-plugin-next": "^15.3.3",
    "@opentelemetry/api": "^1.9.0",
    "@tailwindcss/cli": "^4.1.7",
    "@tanstack/eslint-plugin-query": "^4.39.1",
    "@types/classnames": "^2.3.4",
    "@types/eslint": "^9.6.1",
    "@types/eslint__js": "^9.14.0",
    "@types/react": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "chalk": "^5.4.1",
    "concurrently": "^8.2.2",
    "depcheck": "^1.4.7",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-import-resolver-typescript": "^4.4.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.5.4",
    "globals": "^15.15.0",
    "husky": "^8.0.3",
    "npm-check-updates": "^17.1.18",
    "prettier": "^3.5.3",
    "syncpack": "^13.0.4",
    "turbo": "^2.5.4",
    "typescript-eslint": "^8.33.1"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "@tanstack/react-query": "^5.76.1",
      "react-is": "^18.0.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    }
  }
}

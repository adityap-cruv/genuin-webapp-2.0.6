{
  "name": "@genuin/webapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "components": "npx concurrently \"pnpm --filter @genuin/ui storybook\" \"pnpm --filter @genuin/components storybook\" \"pnpm  --filter @genuin/ui dev:styles\"",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install",
    "check-node": "node ./scripts/check-node-version.js",
    "preinstall": "npm run check-node",
    "predev": "ALLOW_NODE_VERSION_WARNING=true npm run check-node",
    "prebuild": "npm run check-node",
    "use-correct-node": "nvm install && nvm use",
    "upgrade-node": "nvm install 20.12.0 && nvm alias default 20.12.0 && nvm use 20.12.0"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@genuin/eslint-config": "workspace:*",
    "@genuin/typescript-config": "workspace:*",
    "@next/eslint-plugin-next": "^15.3.3",
    "@opentelemetry/api": "^1.9.0",
    "@tanstack/eslint-plugin-query": "^4.34.1",
    "@types/classnames": "^2.3.4",
    "@types/eslint": "^9.6.1",
    "@types/eslint__js": "^9.14.0",
    "@types/react": "19.1.5",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-import-resolver-typescript": "^4.4.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.5.3",
    "globals": "^15.15.0",
    "husky": "^8.0.0",
    "prettier": "^3.2.4",
    "turbo": "^2.5.3",
    "typescript-eslint": "^8.33.0"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "@tanstack/react-query": "^5.74.4",
      "react-is": "^18.0.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    }
  }
}

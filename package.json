{
  "name": "@genuin/monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-build": "node ./scripts/check-chunk-size.js",
    "dev": "turbo run dev",
    "lighthouse": "./scripts/run-lighthouse.sh",
    "typecheck": "turbo run typecheck --filter=!./apps/legacy-webapp",
    "lint": "turbo run lint --filter=!./apps/legacy-webapp",
    "dev:web": "npx concurrently \"pnpm  --filter=@genuin/ui dev:styles\" \"pnpm --filter=@genuin/components dev:styles\" \"pnpm dev --filter=@genuin/webapp -- --turbo\"",
    "dev:sdk": "npx concurrently \"pnpm  --filter=@genuin/ui dev:styles\" \"pnpm --filter=@genuin/components dev:styles\" \"pnpm dev --filter=@genuin/web-sdk\"",
    "build:web": "npx concurrently \"pnpm  --filter=@genuin/ui build:styles\" \"pnpm --filter=@genuin/components build:styles\" \"pnpm build --filter=@genuin/webapp\"",
    "cache:clear": "rm -rf .turbo node_modules/.cache/turbo",
    "modules:clear": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "components": "npx concurrently \"pnpm --filter @genuin/ui storybook\" \"pnpm --filter @genuin/components storybook\" \"pnpm  --filter @genuin/ui dev:styles\" \"pnpm --filter @genuin/components dev:styles\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md}\"",
    "ai:sync": "node scripts/sync-ai-config.mjs",
    "prepare": "husky install",
    "use-correct-node": "nvm install && nvm use",
    "upgrade-node": "nvm install 20.12.0 && nvm alias default 20.12.0 && nvm use 20.12.0",
    "deps:check": "syncpack list-mismatches",
    "deps:fix": "syncpack fix-mismatches",
    "deps:update": "ncu -u && pnpm install",
    "deps:unused": "depcheck",
    "deps:validate": "pnpm deps:check && pnpm deps:unused",
    "test": "concurrently \"pnpm --filter=@genuin/web-sdk test\" \"pnpm --filter=@genuin/webapp test\"",
    "test:ui": "concurrently \"pnpm --filter=@genuin/web-sdk test:ui\" \"pnpm --filter=@genuin/webapp test:ui\"",
    "test:headed": "concurrently \"pnpm --filter=@genuin/web-sdk test:headed\" \"pnpm --filter=@genuin/webapp test:headed\"",
    "test:debug": "concurrently \"pnpm --filter=@genuin/web-sdk test:debug\" \"pnpm --filter=@genuin/webapp test:debug\"",
    "test:doc":"concurrently \"pnpm --filter=@genuin/web-sdk test:doc\" \"pnpm --filter=@genuin/webapp test:doc\"",
    "postinstall": "node scripts/postinstall-patch-openplayerjs.js && pnpm exec playwright install"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cropperjs": "^1.5.13",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.511.0",
    "mitt": "^3.0.1",
    "react": "^19.1.0",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "tailwindcss": "^4.1.8",
    "ua-parser-js": "^2.0.3",
    "zod": "^3.25.16"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@genuin/eslint-config": "workspace:*",
    "@genuin/typescript-config": "workspace:*",
    "@next/eslint-plugin-next": "^15.3.3",
    "@opentelemetry/api": "^1.9.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "^4.1.7",
    "@tanstack/eslint-plugin-query": "^5.78.0",
    "@types/eslint": "^9.6.1",
    "@types/react": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "chalk": "^5.4.1",
    "concurrently": "^8.2.2",
    "depcheck": "^1.4.7",
    "env-cmd": "^10.1.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.5.4",
    "globals": "^15.15.0",
    "husky": "^8.0.3",
    "lighthouse": "^13.0.1",
    "lint-staged": "^16.4.0",
    "npm-check-updates": "^17.1.18",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "syncpack": "^13.0.4",
    "turbo": "^2.9.6",
    "tw-animate-css": "^1.3.0",
    "typescript-eslint": "^8.33.1",
    "wait-on": "^9.0.3"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "@tanstack/react-query": "^5.76.1",
      "react-is": "^18.0.0",
      "unrs-resolver": "1.7.13"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19",
        "eslint": "9"
      },
      "ignoreMissing": [
        "eslint-config-standard-with-typescript"
      ]
    }
  }
}

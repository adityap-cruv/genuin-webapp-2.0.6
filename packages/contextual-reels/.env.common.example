# Shared credentials across all environments.
# Copy to .env.common and fill in the values.
# NEVER commit .env.common — it contains real credentials.

# Oracle Object Storage credentials (S3-compatible API)
ORACLE_ACCESS_KEY=""
ORACLE_SECRET_KEY=""

# Bunny CDN API key for cache purging
BUNNY_API_KEY=""

# Bunny Storage (native HTTP Storage API) — CXR build uploads.
# Uploads use PUT https://<endpoint>/<zone>/<path> with the `AccessKey` header.
# (Bunny's S3-compatible/SigV4 gateway returns AccessDenied for this zone, so we use
#  the native API instead.)
# BUNNY_STORAGE_ACCESS_KEY is the storage-zone password.
BUNNY_STORAGE_ACCESS_KEY=""
BUNNY_STORAGE_ZONE="infolink"
# Native Storage host. Global host routes to the zone's region; leave as-is unless the
# zone needs a region-prefixed host (e.g. https://ny.storage.bunnycdn.com).
BUNNY_STORAGE_ENDPOINT="https://storage.bunnycdn.com"

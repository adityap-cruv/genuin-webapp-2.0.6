# QA environment configuration for contextual-reels.
# Copy to .env.qa and fill in the values.
# NEVER commit .env.qa — it contains real credentials.
# Also requires .env.common — see .env.common.example for Oracle/Bunny credentials.

ENVIRONMENT="qa"

# --- Vite build vars (injected into the app at build time) ---
VITE_CXR_API_BASE_URL=""
VITE_CXR_RUDDERSTACK_KEY=""
VITE_CXR_RUDDERSTACK_DATA_PLANE_URL=""
VITE_CXR_ASSET_BASE_URL=""
VITE_CXR_GEN_AD_BASE_URL=""
VITE_CXR_GENAI_SDK_URL=""

# --- Deploy vars (used by upload/purge scripts, not injected into the app) ---

# Oracle Object Storage — QA region and endpoint
ORACLE_REGION=""
ORACLE_ENDPOINT_URL=""
ORACLE_NAMESPACE=""

# Bunny CDN base URL used to construct purge URLs
MEDIA_BASE_URL="https://media.qa.begenuin.com"

# Comma-separated Oracle upload paths (e.g. cxr/1.0.0)
S3_UPLOAD_PATHS="cxr/1.0.0"

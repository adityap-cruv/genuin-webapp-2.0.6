# Development environment configuration for contextual-reels.
# Copy to .env.development — used by `npm run dev`.
# NEVER commit .env.development if you add real credentials.
#
# QA / Production deploys:
#   cp .env.qa.example .env.qa           (fill in Oracle/Bunny creds + VITE_RUDDERSTACK_KEY)
#   cp .env.production.example .env.production
#   cp .env.common.example .env.common   (Oracle + Bunny API keys)
#   Run: npm run deploy:qa  OR  npm run deploy:prod
#
# Vite auto-loads the right file based on --mode:
#   npm run dev          → .env.development
#   npm run build:qa     → .env.qa
#   npm run build:prod   → .env.production

NODE_ENV="development"

# --- Vite build vars (injected into the app at build time) ---
VITE_CXR_API_BASE_URL=""
VITE_CXR_RUDDERSTACK_KEY=""
VITE_CXR_RUDDERSTACK_DATA_PLANE_URL=""
VITE_CXR_ASSET_BASE_URL=""
VITE_CXR_GEN_AD_BASE_URL=""
VITE_CXR_GENAI_SDK_URL=""

{
    "name": "@genuin/genai-sdk",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "preview:build": "pnpm exec cross-env NODE_ENV=development BUILD_TARGET=preview vite build --mode development",
        "preview": "pnpm preview:build && pnpm exec vite preview --outDir dist",
        "dev:app": "cross-env NODE_ENV=development npm run validate:env && cross-env NODE_ENV=development vite --mode development",
        "dev": "cross-env NODE_ENV=development npm run validate:env && pnpm exec concurrently \"pnpm exec cross-env NODE_ENV=development vite build --mode development --watch\" \"serve dist --cors -l tcp://0.0.0.0:5500\"",
        "lint": "eslint .",
        "format": "prettier --write .",
        "validate:env": "npx tsx scripts/validateEnv.ts",
        "build": "cross-env NODE_ENV=development npm run validate:env && pnpm exec cross-env NODE_ENV=development tsc -b && vite build --mode development",
        "minify-chunks": "find dist -name '*.js' -exec terser {} --compress drop_console=true,drop_debugger=true,passes=3 --mangle toplevel=true --format beautify=false,comments=false,semicolons=true,braces=true,max_line_len=false,wrap_func_args=false -o {} \\;",
        "build:qa": "cross-env NODE_ENV=qa npm run validate:env && pnpm exec cross-env NODE_ENV=qa tsc -b && vite build --mode qa && pnpm minify-chunks",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "pnpm exec tsc -b",
        "build:prod": "cross-env NODE_ENV=production npm run validate:env && pnpm exec cross-env NODE_ENV=production tsc -b && vite build --mode production && pnpm minify-chunks",
        "publish:qa": "pnpm exec cross-env NODE_ENV=qa npx ts-node scripts/publish.ts",
        "publish:prod": "pnpm exec cross-env NODE_ENV=production npx ts-node scripts/publish.ts",
        "storybook": "env-cmd -f .env.development storybook dev -p 6007 --ci",
        "build-storybook": "storybook build"
    },
    "dependencies": {
        "@genuin/analytics": "workspace:*",
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-dropdown-menu": "^2.1.15",
        "@radix-ui/react-popover": "^1.1.14",
        "@radix-ui/react-select": "^2.2.5",
        "@radix-ui/react-slot": "^1.2.3",
        "@rudderstack/analytics-js": "^3.11.16",
        "axios": "^1.9.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.511.0",
        "next-themes": "^0.4.6",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-markdown": "^10.1.0",
        "rehype-raw": "^7.0.0",
        "remark-gfm": "^4.0.1",
        "serve": "^14.2.1",
        "sonner": "^2.0.5",
        "tailwind-merge": "^3.3.0",
        "uuid": "^11.0.5"
    },
    "devDependencies": {
        "@aws-sdk/client-cloudfront": "^3.835.0",
        "@aws-sdk/client-s3": "^3.835.0",
        "@aws-sdk/credential-provider-ini": "^3.835.0",
        "@eslint/js": "^9.25.0",
        "@genuin/eslint-config": "workspace:*",
        "@inquirer/prompts": "^3.3.0",
        "@tailwindcss/postcss": "^4.1.8",
        "@tailwindcss/vite": "^4.1.10",
        "@testing-library/jest-dom": "^6.0.0",
        "@testing-library/react": "^16.0.0",
        "@testing-library/user-event": "^14.0.0",
        "@types/cli-progress": "^3.11.6",
        "@types/node": "^22.15.21",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@chromatic-com/storybook": "^4.0.0",
        "@storybook/addon-docs": "^9.0.0",
        "@storybook/react-vite": "^9.0.0",
        "@vitejs/plugin-react-swc": "^3.9.0",
        "@vitest/coverage-v8": "^2.0.0",
        "cli-progress": "^3.12.0",
        "concurrently": "^8.2.2",
        "cross-env": "^7.0.3",
        "dotenv": "^16.0.3",
        "env-cmd": "^10.1.0",
        "storybook": "^9.0.0",
        "eslint": "^9.25.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "jsdom": "^25.0.0",
        "postcss-prefixwrap": "^1.55.0",
        "prettier": "^3.5.3",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "tailwindcss": "^4.1.8",
        "terser": "^5.43.1",
        "tsx": "^4.20.5",
        "tw-animate-css": "^1.3.0",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.30.1",
        "vite": "^6.3.5",
        "vitest": "^2.0.0",
        "zod": "^3.23.8"
    },
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./dist/genai-sdk.es.js",
            "default": "./dist/genai-sdk.es.js"
        },
        "./styles": {
            "default": "./dist/genai-sdk.css"
        }
    },
    "main": "./dist/genai-sdk.es.js",
    "types": "./index.d.ts"
}

{
    "name": "@genuin/genai-sdk",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "preview": "vite preview",
        "dev": "pnpm exec concurrently \"pnpm exec cross-env NODE_ENV=development vite build --mode development --watch\" \"serve dist --cors -l tcp://0.0.0.0:5500\"",
        "lint": "eslint .",
        "format": "prettier --write .",
        "build": "pnpm exec cross-env NODE_ENV=development tsc -b && vite build --mode development",
        "minify-chunks": "find dist -name '*.js' -exec terser {} --compress drop_console=true,drop_debugger=true,passes=3 --mangle toplevel=true --format beautify=false,comments=false,semicolons=true,braces=true,max_line_len=false,wrap_func_args=false -o {} \\;",
        "build:qa": "pnpm exec cross-env NODE_ENV=qa tsc -b && vite build --mode qa && pnpm minify-chunks",
        "build:prod": "pnpm exec cross-env NODE_ENV=production tsc -b && vite build --mode production && pnpm minify-chunks",
        "publish:qa": "pnpm exec cross-env NODE_ENV=qa npx ts-node scripts/publish.ts",
        "publish:prod": "pnpm exec cross-env NODE_ENV=production npx ts-node scripts/publish.ts"
    },
    "dependencies": {
        "@lottiefiles/react-lottie-player": "^3.5.4",
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-dropdown-menu": "^2.1.15",
        "@radix-ui/react-popover": "^1.1.14",
        "@radix-ui/react-select": "^2.2.5",
        "@radix-ui/react-slot": "^1.2.3",
        "@rudderstack/analytics-js": "^3.11.16",
        "axios": "^1.9.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "draggabilly": "^3.0.0",
        "framer-motion": "^10.18.0",
        "lucide-react": "^0.511.0",
        "next-themes": "^0.4.6",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-markdown": "^10.1.0",
        "rehype-raw": "^7.0.0",
        "remark-gfm": "^4.0.1",
        "serve": "^14.2.1",
        "sonner": "^2.0.5",
        "tailwind-merge": "^3.3.0",
        "uuid": "^11.0.5"
    },
    "devDependencies": {
        "@eslint/js": "^9.25.0",
        "@inquirer/prompts": "^3.3.0",
        "@tailwindcss/postcss": "^4.1.8",
        "@tailwindcss/vite": "^4.1.10",
        "@types/draggabilly": "^2.1.6",
        "@types/node": "^22.15.21",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@vitejs/plugin-react-swc": "^3.9.0",
        "cli-progress": "^3.12.0",
        "concurrently": "^8.2.2",
        "cross-env": "^7.0.3",
        "dotenv": "^16.0.3",
        "eslint": "^9.25.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "postcss-prefixwrap": "^1.55.0",
        "prettier": "^3.5.3",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "tailwindcss": "^4.1.8",
        "tailwindcss-animate": "^1.0.7",
        "terser": "^5.43.1",
        "tw-animate-css": "^1.3.0",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.30.1",
        "vite": "^6.3.5"
    },
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./dist/genai-sdk.es.js",
            "default": "./dist/genai-sdk.es.js"
        },
        "./styles": {
            "default": "./dist/genai-sdk.css"
        }
    },
    "main": "./dist/genai-sdk.es.js",
    "types": "./index.d.ts"
}
ENVIRONMENT="qa"
DOMAIN="qa.begenuin.com"
BASE_URL="https://app.qa.begenuin.com"
API_BASE_URL="https://api.qa.begenuin.com"
MEDIA_BASE_URL="https://media.qa.begenuin.com"
RUDDERSTACK_URL="https://rudderstack.qa.begenuin.com"
RUDDERSTACK_API_KEY="your-qa-api-key"
ENCRYPTION_SALT="your-qa-salt"
NEXT_PUBLIC_BCC_URL="https://brands.qa.begenuin.com"

# AWS S3 and CloudFront Configuration
# These settings are required for publishing SDK builds to S3 and managing CloudFront cache
# You can either:
# 1. Leave AWS credentials empty to use AWS CLI configuration (recommended)
# 2. Set the credentials here if you're not using AWS CLI

# S3 Configuration for QA
S3_BUCKET_NAME=""  # The S3 bucket where SDK builds will be uploaded
S3_REGION=""       # AWS region where the bucket is located (e.g., us-west-2)

# AWS Credentials (Optional - Leave empty if using AWS CLI configuration)
# Required permissions: s3:PutObject, cloudfront:CreateInvalidation
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# CloudFront Configuration
# Required for automatically invalidating CDN cache after S3 uploads
CLOUDFRONT_DISTRIBUTION_ID=""  # The CloudFront distribution ID serving the SDK files
  <body>
 
    <!-- only one embeds with contextual feed , use your embed_id and api_key, and embed_id must be unique-->
     <div
      id="gen-sdk"
      class="gen-sdk-class"
      style="width: 100%; height: 500px"></div>

    <script src="./dist/gen_sdk.js"></script>


{
  "name": "@genuin/web-sdk",
  "version": "1.2.10",
  "description": "Web SDK for Genuin Inc.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "build:css": "tailwindcss -i ./src/views/main.css -o ./src/views/output.css",
    "watch:css": "pnpm run build:css -- --watch",
    "validate:env": "node --loader ts-node/esm scripts/validateEnv.ts",
    "prebuild": "cross-env NODE_ENV=development pnpm run clean && pnpm run build:css && pnpm run validate:env",
    "prebuild:qa": "cross-env NODE_ENV=qa pnpm run clean && pnpm run build:css && cross-env NODE_ENV=qa pnpm run validate:env",
    "prebuild:prod": "cross-env NODE_ENV=production pnpm run clean && pnpm run build:css && cross-env NODE_ENV=production pnpm run validate:env",
    "build": "cross-env NODE_ENV=development rollup -c rollup.config.mjs",
    "build:qa": "cross-env NODE_ENV=qa npx ts-node scripts/build.ts",
    "build:prod": "cross-env NODE_ENV=production npx ts-node scripts/build.ts",
    "publish:s3:qa": "cross-env NODE_ENV=qa npx ts-node scripts/uploadToS3.ts",
    "publish:s3:prod": "cross-env NODE_ENV=production npx ts-node scripts/uploadToS3.ts",
    "dev": "cross-env NODE_ENV=development pnpm run validate:env && concurrently \"pnpm run watch:css\" \"cross-env NODE_ENV=development rollup -c -w\" \"npx serve .\"",
    "dev:qa": "cross-env NODE_ENV=qa pnpm run validate:env && concurrently \"pnpm run watch:css\" \"cross-env NODE_ENV=qa rollup -c -w\" \"npx serve .\"",
    "dev:prod": "cross-env NODE_ENV=production pnpm run validate:env && concurrently \"pnpm run watch:css\" \"cross-env NODE_ENV=production rollup -c -w\" \"npx serve .\"",
    "format": "prettier --write .",
    "version:bump": "npx ts-node scripts/npmVersionManager.ts",
    "build-no-check": "cross-env NODE_ENV=development rollup -c rollup.config.mjs --no-strict"
  },
  "author": "Genuin Inc.",
  "license": "ISC",
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "^3.540.0",
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/credential-provider-ini": "^3.540.0",
    "@babel/preset-react": "^7.24.7",
    "@inquirer/prompts": "^3.3.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^26.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.7",
    "@rollup/plugin-strip": "^3.0.4",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/cli-progress": "^3.11.5",
    "@types/node": "^20.17.6",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.20",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.5",
    "dotenv": "^16.0.3",
    "libphonenumber-js": "^1.12.6",
    "postcss": "^8.5.3",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.5",
    "rollup": "^4.40.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "serve": "^14.2.1",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.1.7",
    "@tanstack/react-query": "^5.62.16",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "crypto-es": "^2.1.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.469.0",
    "react": "^19.1.0",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.2",
    "react-phone-number-input": "^3.4.11",
    "react-qrcode-logo": "^3.0.0",
    "swiper": "^11.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "ua-parser-js": "^2.0.0",
    "use-debounce": "^10.0.4",
    "uuid": "^11.0.5",
    "wouter": "^3.5.1",
    "zod": "^3.24.1"
  }
}

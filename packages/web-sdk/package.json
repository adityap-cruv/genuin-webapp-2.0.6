{
  "name": "@genuin/web-sdk",
  "version": "1.2.14",
  "description": "Web SDK for Genuin Inc.",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf dist",
    "validate:env": "npx ts-node scripts/validateEnv.ts",
    "prebuild": "cross-env NODE_ENV=development npm run clean && npm run validate:env",
    "prebuild:qa": "cross-env NODE_ENV=qa npm run clean && cross-env NODE_ENV=qa npm run validate:env",
    "prebuild:prod": "cross-env NODE_ENV=production npm run clean && cross-env NODE_ENV=production npm run validate:env",
    "predev": "cross-env NODE_ENV=development npm run clean",
    "predev:qa": "cross-env NODE_ENV=qa npm run clean",
    "predev:prod": "cross-env NODE_ENV=production npm run clean",
    "build": "env-cmd -f ./.env.development cross-env NODE_ENV=development vite build",
    "build:qa": "env-cmd -f ./.env.qa cross-env NODE_ENV=qa vite build",
    "build:prod": "env-cmd -f ./.env.production cross-env NODE_ENV=production vite build",
    "copy-loader": "mkdir -p dist && cp src/loader.js dist/genuin-loader.js",
    "copy-loader:dev": "mkdir -p dist && cp src/loader.js dist/gen_sdk.js",
    "copy-loader:qa": "mkdir -p dist && cp src/loader.js dist/gen_sdk.min.js",
    "copy-loader:prod": "mkdir -p dist && cp src/loader.js dist/gen_sdk.min.js",
    "dev": "env-cmd -f ./.env.development cross-env NODE_ENV=development npm run validate:env && env-cmd -f ./.env.development cross-env NODE_ENV=development vite build --watch",
    "dev:qa": "env-cmd -f ./.env.qa cross-env NODE_ENV=qa npm run validate:env && env-cmd -f ./.env.qa cross-env NODE_ENV=qa vite build --watch",
    "dev:prod": "env-cmd -f ./.env.production cross-env NODE_ENV=production npm run validate:env && env-cmd -f ./.env.production cross-env NODE_ENV=production vite build --watch",
    "dev:vite": "vite",
    "publish:s3:qa": "env-cmd -f ./.env.qa cross-env NODE_ENV=qa npx ts-node scripts/uploadToS3.ts",
    "publish:s3:prod": "env-cmd -f ./.env.production cross-env NODE_ENV=production npx ts-node scripts/uploadToS3.ts",
    "analyze": "cross-env ANALYZE=true NODE_ENV=production npm run build:prod",
    "test:bundle": "node scripts/test-bundle.js",
    "validate": "npm run typecheck && npm run build",
    "format": "prettier --write .",
    "lint": "eslint --ext .ts,.tsx src/",
    "typecheck": "tsc --noEmit",
    "version:bump": "npx ts-node scripts/npmVersionManager.ts"
  },
  "author": "Genuin Inc.",
  "license": "ISC",
  "peerDependencies": {
    "@tanstack/react-query": "^5.76.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "dependencies": {
    "@genuin/components": "workspace:*",
    "@genuin/ui": "workspace:*",
    "crypto-es": "^2.1.0",
    "dompurify": "^3.2.5",
    "pubsub-js": "^1.9.5",
    "tailwind-merge": "^3.3.0",
    "ua-parser-js": "^2.0.3",
    "uuid": "^11.0.5",
    "wouter": "^3.5.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudfront": "^3.540.0",
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/credential-provider-ini": "^3.540.0",
    "@genuin/eslint-config": "workspace:*",
    "@genuin/typescript-config": "workspace:*",
    "@inquirer/prompts": "^3.3.0",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@rollup/plugin-url": "^8.0.2",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/cli-progress": "^3.11.5",
    "@types/node": "^22.15.21",
    "@types/pubsub-js": "^1.8.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "buffer": "^6.0.3",
    "chalk": "^5.4.1",
    "cli-progress": "^3.12.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "cssnano": "^7.0.5",
    "dotenv": "^17.2.1",
    "env-cmd": "^10.1.0",
    "eslint": "^9.28.0",
    "postcss": "^8.5.3",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.5.3",
    "rimraf": "^5.0.5",
    "rollup": "^4.46.2",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "serve": "^14.2.1",
    "stream-browserify": "^3.0.0",
    "tailwindcss": "^4.1.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "util": "^0.12.5",
    "vite": "^7.0.0"
  }
}

{
  "name": "@genuin/components",
  "sideEffects": [
    "**/*.css",
    "dist/index.css"
  ],
  "private": true,
  "description": "Genuin's components",
  "authors": "Genuin Inc.",
  "version": "1.0.0",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*",
    "./globals.css": "./src/globals.css",
    "./styles": {
      "types": "./dist/index.css.d.ts",
      "default": "./dist/index.css"
    },
    "./assets/*": "./src/assets/*",
    "./lib/*": "./src/lib/*"
  },
  "peerDependencies": {
    "@radix-ui/react-slider": "^1.3.5",
    "@tailwindcss/cli": "^4.1.7",
    "cropperjs": "^1.5.13",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.4",
    "tailwindcss": "^4.1.8",
    "ua-parser-js": "^2.0.3"
  },
  "dependencies": {
    "@genuin/genai-sdk": "workspace:*",
    "@genuin/ui": "workspace:*",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@tanstack/react-query": "^5.76.1",
    "axios": "^1.9.0",
    "crypto-es": "^2.1.0",
    "dompurify": "^3.2.5",
    "motion": "^12.18.1",
    "next": "15.3.9",
    "openplayerjs": "^2.14.10",
    "react-drag-drop-files": "^3.0.1",
    "react-phone-number-input": "^3.4.12",
    "react-qr-code": "^2.0.16",
    "react-remove-scroll": "^2.7.1",
    "swiper": "^11.2.7",
    "usehooks-ts": "^3.1.1",
    "uuid": "^11.0.5",
    "web-vitals": "^5.1.0",
    "wouter": "^3.5.1",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@inquirer/prompts": "^7.0.0",
    "@types/cli-progress": "^3.11.6",
    "@chromatic-com/storybook": "^4.0.0",
    "@genuin/eslint-config": "workspace:*",
    "@genuin/tailwind-config": "workspace:*",
    "@genuin/typescript-config": "workspace:*",
    "@storybook/addon-docs": "^9.0.0",
    "@storybook/addon-onboarding": "^9.0.0",
    "@storybook/addon-vitest": "9.0.0",
    "@storybook/react": "^9.0.5",
    "@storybook/react-vite": "^9.0.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "eslint-plugin-storybook": "9.0.0",
    "storybook": "^9.0.0",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "chalk": "^5.0.0",
    "cli-progress": "^3.12.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.0",
    "env-cmd": "^10.1.0",
    "tsx": "^4.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --build",
    "storybook": "env-cmd -f ../../.env storybook dev -p 6005",
    "build-storybook": "storybook build",
    "preinstall": "pnpm run build:styles",
    "build:styles": "npx @tailwindcss/cli -i ./src/globals.css -o ./dist/index.css",
    "dev:styles": "npx @tailwindcss/cli -i ./src/globals.css -o ./dist/index.css --watch",
    "lint-staged": "lint-staged",
    "publish:storybook:oracle:qa": "env-cmd -f ./.env.qa cross-env NODE_ENV=qa npx tsx scripts/uploadStorybookToOracle.ts",
    "publish:storybook:oracle:prod": "env-cmd -f ./.env.production cross-env NODE_ENV=production npx tsx scripts/uploadStorybookToOracle.ts",
    "deploy:storybook:qa": "npm run build-storybook && npm run publish:storybook:oracle:qa",
    "deploy:storybook:prod": "npm run build-storybook && npm run publish:storybook:oracle:prod"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}

{
  "extends": "@genuin/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@genuin/ui": [
        "../ui/src"
      ],
      "@genuin/ui/*": [
        "../ui/src/*"
      ],
      "@genuin/components": [
        "./src"
      ],
      "@genuin/components/*": [
        "./src/*"
      ],
    },
    "types": [
      "eslint",
      "react"
    ],
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "src",
    "vite-env.d.ts",
  ],
  "exclude": [
    "dist",
    "build",
    "**/node_modules/**",
  ]
}
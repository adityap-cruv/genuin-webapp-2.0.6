{
  "extends": "@genuin/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@templates/*": [
        "./src/templates/*"
      ],
      "@pages/*": [
        "./src/page/*"
      ],
      "@organisms/*": [
        "./src/organisms/*"
      ],
      "@molecules/*": [
        "./src/molecules/*"
      ],
      "@atoms/*": [
        "./src/atoms/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@react-query/*": [
        "./src/react-query/*"
      ],
      "@types/*": [
        "./src/types/*"
      ],
      "@context/*": [
        "./src/context/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@genuin/ui": [
        "../ui/src"
      ],
      "@genuin/ui/*": [
        "../ui/src/*"
      ],
      "@genuin/components": [
        "./src"
      ],
      "@genuin/components/*": [
        "./src/*"
      ],
    },
    "types": [
      "eslint",
      "react"
    ],
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "src",
  ],
  "exclude": [
    "dist",
    "build",
    "**/node_modules/**",
  ]
}
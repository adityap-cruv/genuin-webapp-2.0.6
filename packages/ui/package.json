  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006 --ci",
    "build-storybook": "storybook build",
    "preinstall": "pnpm run build:styles",
    "build:styles": "npx @tailwindcss/cli -i ./src/styles/globals.css -o ./dist/index.css",
    "dev:styles": "npx @tailwindcss/cli -i ./src/styles/globals.css -o ./dist/index.css --watch",
    "test": "jest && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint-staged": "lint-staged",
    "publish:storybook:oracle:qa": "env-cmd -f ./.env.qa cross-env NODE_ENV=qa npx tsx scripts/uploadStorybookToOracle.ts",
    "publish:storybook:oracle:prod": "env-cmd -f ./.env.production cross-env NODE_ENV=production npx tsx scripts/uploadStorybookToOracle.ts",
    "deploy:storybook:qa": "npm run build-storybook && npm run publish:storybook:oracle:qa",
    "deploy:storybook:prod": "npm run build-storybook && npm run publish:storybook:oracle:prod"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ]

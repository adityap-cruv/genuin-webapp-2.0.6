{
  "extends": "@genuin/typescript-config/react-library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["react", "react-dom", "node"],
    "composite": true,
    "incremental": true,
    "outDir": "dist/types",
    "rootDir": "src",
    "paths": {
      "@genuin/ui": ["./src"],
      "@genuin/ui/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "build", "**/node_modules/**"]
}

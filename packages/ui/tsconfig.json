{
  "extends": "@genuin/typescript-config/react-library.json",
  "compilerOptions": {
    "jsx": "react-jsx", // Added for React 19+ JSX transform
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "types": [
      "eslint",
      "react",
      "react-dom",
      "node"
    ],
    "paths": {
      "@components/*": ["./src/components/*"],
      "@lib/*": ["./src/lib/*"],
      "@genuin/ui": ["./src"],
      "@genuin/ui/*": ["./src/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@icons/*": ["./src/icons/*"]
    }
  },
  "include": [
    "src",
  ],
  "exclude": [
    "dist",
    "build",
    "**/node_modules/**",
  ]
}
{
  "extends": "@genuin/typescript-config/react-library.json",
  "compilerOptions": {
    "jsx": "react-jsx", // Added for React 19+ JSX transform
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "types": [
      "eslint",
      "react",
      "react-dom",
      "node"
    ],
    "paths": {
      "@genuin/ui": ["./src"],
      "@genuin/ui/*": ["./src/*"]
    },

  },
  "include": [
    "src",
  ],
  "exclude": [
    "dist",
    "build",
    "**/node_modules/**",
  ]
}
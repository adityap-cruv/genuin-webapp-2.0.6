#!/usr/bin/env sh
if [ -z "$husky_skip_init" ]; then
  # Branch gate. Deliberately FIRST — it is a regex on a string, so it fails in
  # milliseconds rather than after the two production builds below, and it runs
  # before husky's shim so HUSKY=0 cannot skip it.
  #
  # We read the ref list from STDIN, which is what git actually hands this hook:
  #   <local ref> <local sha> <remote ref> <remote sha>
  # Gating on the CHECKED-OUT branch instead would miss
  # `git push origin HEAD:refs/heads/whatever`, pushing a different branch, and
  # --all/--mirror, and would skip the gate entirely on a detached HEAD.
  . "$(dirname -- "$0")/../scripts/jira-hook/lib.sh"
  JIRA_ZERO=0000000000000000000000000000000000000000
  JIRA_REJECTED=""
  while read -r _lref _lsha JIRA_RREF _rsha; do
    [ -n "$JIRA_RREF" ] || continue
    [ "$_lsha" = "$JIRA_ZERO" ] && continue            # branch deletion
    case "$JIRA_RREF" in refs/heads/*) JIRA_B=${JIRA_RREF#refs/heads/} ;; *) continue ;; esac
    jira_is_exempt_branch "$JIRA_B" && continue
    jira_is_trunk_branch "$JIRA_B" && continue
    jira_is_grandfathered "$JIRA_B" && continue
    jira_branch_is_valid "$JIRA_B" && continue
    JIRA_REJECTED="$JIRA_REJECTED $JIRA_B"
  done
  if [ -n "$JIRA_REJECTED" ]; then
    printf '\n❌ Push rejected: these branches cannot be traced to a Jira ticket.\n\n'
    for JIRA_B in $JIRA_REJECTED; do
      printf '    %s\n' "$JIRA_B"
      jira_hint_rename "$JIRA_B"
    done
    printf '\n    expected: <type>/GEN-<ticket>/<slug>\n'
    printf '    types:    feature | bugfix | hotfix | chore | docs\n'
    printf '\n  Details: README.md#commits--branches\n\n'
    exit 1
  fi
fi

# Guarded: .husky/_ is gitignored, so a fresh `git worktree add` has no husky.sh
# until pnpm install runs. Unguarded, that failed with a bare
# "No such file or directory" and no explanation.
[ -f "$(dirname -- "$0")/_/husky.sh" ] && . "$(dirname -- "$0")/_/husky.sh"

# Exit immediately when Ctrl+C is pressed
trap 'echo ""; echo "❌ Aborted by user"; exit 130' INT

set +e


echo "🔨 Running pre-push checks..."
echo ""

# ---------------------------------------------------------------------------
# Environment preflight
#
# These files are gitignored, so a fresh clone or `git worktree add` has none of
# them. Every one below is load-bearing for the checks further down:
#
#   .env                               apps/webapp build
#   packages/web-sdk/.env.common       fatal in web-sdk validateEnv
#   packages/web-sdk/.env.development  typecheck -> ^build (dev)
#   packages/web-sdk/.env.production   build:prod
#   packages/genai/.env.development    typecheck -> ^build (dev)
#   packages/genai/.env.production     build:prod -> genai build:prod
#
# Only two of these used to be checked here. The rest failed deep inside turbo as
# "Failed: @genuin/genai-sdk#build" followed by "❌ Type check failed!" — which
# names the wrong cause entirely and sends people hunting for type errors that do
# not exist. Check them all, up front, and report every missing one at once.
# ---------------------------------------------------------------------------
echo "📋 Checking environment files..."
REQUIRED_ENV_FILES="
.env
packages/web-sdk/.env.common
packages/web-sdk/.env.development
packages/web-sdk/.env.production
packages/genai/.env.development
packages/genai/.env.production
"
MISSING_ENV=0
for ENV_FILE in $REQUIRED_ENV_FILES; do
  [ -f "$ENV_FILE" ] && continue
  if [ "$MISSING_ENV" -eq 0 ]; then
    echo ""
    echo "❌ Push rejected: required environment files are missing."
    echo ""
    MISSING_ENV=1
  fi
  echo "   missing: $ENV_FILE"
  if [ -f "$ENV_FILE.example" ]; then
    echo "            cp $ENV_FILE.example $ENV_FILE"
  else
    echo "            no .example for this one — copy it from another worktree,"
    echo "            or ask your team lead for the values."
  fi
done
if [ "$MISSING_ENV" -ne 0 ]; then
  echo ""
  echo "   Then fill in any placeholder values before pushing."
  echo ""
  exit 1
fi
echo "✅ Environment files present"

echo ""
echo "🔍 Running type checks..."
pnpm typecheck
TYPECHECK_STATUS=$?
if [ $TYPECHECK_STATUS -ne 0 ]; then
  echo ""
  echo "❌ Type check failed!"
  echo "❌ Push rejected. Please fix type errors and try again."
  exit 1
fi
echo "✅ Type checks passed"

echo ""
echo "⚠️  Building production bundles for SDK and Web App..."
echo "⏳ This may take a few minutes..."
echo ""

# Build SDK Production
echo "📦 Building SDK (production)..."
pnpm --filter=@genuin/web-sdk run build:prod 
SDK_STATUS=$?
if [ $SDK_STATUS -ne 0 ]; then
  echo ""
  echo "❌ SDK production build failed!"
  echo "❌ Push rejected. Please fix the build errors and try again."
  exit 1
fi
echo "✅ SDK production build successful"
echo ""

# Build Web App Production
echo "🌐 Building Web App (production)..."
pnpm turbo build --filter=./apps/webapp --filter=!@genuin/web-sdk
WEBAPP_STATUS=$?
if [ $WEBAPP_STATUS -ne 0 ]; then
  echo ""
  echo "❌ Web App production build failed!"
  echo "❌ Push rejected. Please fix the build errors and try again."
  exit 1
fi

echo "✅ Web App production build successful"
echo ""

# Chunk Checking
echo "📏 Checking bundle size..."
pnpm check-build
BUNDLE_CHECK_STATUS=$?
if [ $BUNDLE_CHECK_STATUS -ne 0 ]; then
  echo ""
  echo "❌ Bundle size check failed!"
  echo "❌ Push rejected. Please optimize bundle size and try again."
  exit 1
fi
echo "✅ Bundle size check passed"
echo ""

# add test cases before this

# ---------------------------------------------------------------------------
# Contextual Reels (CXR)
#
# Gated here (~25 s): lint (src + tests) · unit tests + per-file coverage gates.
#
# Deliberately MANUAL — each needs a built dist/ and/or hits the real QA
# exchange, so none of them belongs on every push:
#   pnpm --filter @genuin/contextual-reels test:e2e        (needs `build` first)
#   pnpm --filter @genuin/contextual-reels budget:all      (~19 min, real ad requests)
#   pnpm --filter @genuin/contextual-reels fixtures:check  (~5 s, live QA read)
#
# CI runs only the label-gated E2E job (e2e-cxr.yml) — label a PR `run-e2e-all`.
#
# Escape hatch: SKIP_CXR_CHECKS=1 git push
# Catalogue + measured times: packages/contextual-reels/docs/TESTING.md
# ---------------------------------------------------------------------------
if [ "$SKIP_CXR_CHECKS" = "1" ]; then
  echo "⏭️  Skipping Contextual Reels checks (SKIP_CXR_CHECKS=1)"
  echo ""
else
  echo "🎬 Linting Contextual Reels..."
  pnpm --filter @genuin/contextual-reels lint
  CXR_LINT_STATUS=$?
  if [ $CXR_LINT_STATUS -ne 0 ]; then
    echo ""
    echo "❌ Contextual Reels lint failed!"
    echo "❌ Push rejected. Fix the lint errors and try again."
    exit 1
  fi
  echo "✅ Contextual Reels lint passed"
  echo ""

  # Coverage, not plain `test`: the per-file thresholds in vitest.config.ts are
  # the actual gate, and they only run under --coverage.
  echo "🧪 Running Contextual Reels tests + coverage gates..."
  pnpm --filter @genuin/contextual-reels test:coverage
  CXR_TEST_STATUS=$?
  if [ $CXR_TEST_STATUS -ne 0 ]; then
    echo ""
    echo "❌ Contextual Reels tests or coverage thresholds failed!"
    echo "❌ Push rejected. A failing test also short-circuits the coverage check —"
    echo "❌ fix the failures first, then re-read the threshold report."
    exit 1
  fi
  echo "✅ Contextual Reels tests + coverage passed"
  echo ""

fi

# Lighthouse Performance Testing commented for now as it is very flaky and causing issues with pushes. Will re-enable once we have a more stable setup.
echo "🔦 Running Lighthouse performance checks..."
# pnpm lighthouse
LIGHTHOUSE_STATUS=$?
if [ $LIGHTHOUSE_STATUS -ne 0 ]; then
  echo ""
  echo "❌ Lighthouse performance check failed!"
  echo "❌ Push rejected. Please improve performance and try again."
  echo "⚠️ Close anything that might slow your system"
  exit 1
fi
echo "✅ Lighthouse check passed"
echo ""

echo "✅ All production builds successful!"
echo "✅ Proceeding with push..."
echo ""

#!/usr/bin/env sh
# Rebuild the graphify graph after a branch checkout (or nudge if the CLI isn't
# installed). post-checkout args: $1=prev $2=new $3=branch-flag (1=branch, 0=file).
[ "$3" = "1" ] || exit 0

# Flag an unusable branch name at the moment it is created, when renaming is free.
# This hook CANNOT block — git ignores its exit status — so it only warns, and only
# for branches that are actually actionable: grandfathered ones are skipped so that
# checking out in-flight work does not nag on every switch.
. "$(dirname -- "$0")/../scripts/jira-hook/lib.sh"
JIRA_BRANCH=$(jira_current_branch)
if [ -n "$JIRA_BRANCH" ] \
  && ! jira_is_exempt_branch "$JIRA_BRANCH" \
  && ! jira_branch_is_valid "$JIRA_BRANCH" \
  && ! jira_is_trunk_branch "$JIRA_BRANCH"; then
  if jira_is_grandfathered "$JIRA_BRANCH"; then
    # Say it out loud. Silence here meant a new branch sharing a listed name was an
    # unannounced, permanent opt-out.
    printf '\n  Note: "%s" is on the pre-enforcement list, so no ticket is required.\n' "$JIRA_BRANCH"
    printf '  If this is NEW work, use <type>/GEN-<ticket>/<slug> instead.\n\n'
  else
  printf '\n  This branch cannot be traced to a Jira ticket.\n\n'
    printf '    branch:   %s\n' "$JIRA_BRANCH"
    printf '    expected: <type>/GEN-<ticket>/<slug>\n'
    printf '    types:    feature | bugfix | hotfix | chore | docs\n\n'
    printf '  Rename it now, before you commit:\n\n'
    jira_hint_rename "$JIRA_BRANCH"
    printf '\n'
  fi
fi

sh "$(dirname -- "$0")/../scripts/graphify-hook.sh" checkout
